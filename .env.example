# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/cadastral_fieldbook
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/cadastral_fieldbook
MONGODB_URI=mongodb://127.0.0.1:27017/cadastral_fieldbook

# Secret used to sign login session tokens (JWT). Must be a long random
# string and MUST be kept secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=replace-this-with-a-long-random-string

# SMTP (Gmail) — sends "forgot password" reset-link emails (src/lib/mailer.js).
# Use a Gmail App Password (Google Account -> Security -> App passwords), not
# your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=replace-with-your-gmail-address
SMTP_PASS=replace-with-your-gmail-app-password

# Public base URL used to build the link inside the reset-password email.
APP_BASE_URL=http://localhost:3001
